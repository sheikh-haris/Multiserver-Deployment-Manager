{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=(local);Database=IisControlCenter;Integrated Security=True;TrustServerCertificate=True"
  },
  "Database": { "Provider": "SqlServer", "MigrateOnStartup": false },
  "Auth": { "Mode": "Entra", "BootstrapAdmins": [] },
  "AzureAd": { "TenantId": "", "ClientId": "", "ClientSecret": "" },
  "Portal": {
    "AgentsHost": "",
    "HttpsPort": 443,
    "Tls": { "Thumbprint": "", "PfxPath": "" }
  },
  "Hangfire": { "Enabled": true },
  "Deployments": {
    "PackageStorePath": "App_Data/packages",
    "MaxPackageMb": 500,
    "RetentionDays": 90,
    "BackupsToKeep": 5,
    "AntivirusMode": "Auto",
    "PublicBaseUrl": ""
  },
  "Notifications": { "Smtp": { "Host": "", "Port": 25, "UseSsl": false, "From": "iis-control-center@localhost" } }
}

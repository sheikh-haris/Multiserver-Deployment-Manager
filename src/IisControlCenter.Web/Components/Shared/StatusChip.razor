<MudChip @key="@Status" T="string" Size="Size.Small" Color="@_color" Variant="Variant.Filled" Class="@Class">@(Text ?? Status)</MudChip>
@code {
    /// <summary>One colour map for the whole portal.</summary>
    [Parameter] public string Status { get; set; } = "";
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Class { get; set; }

    private Color _color => Status switch
    {
        "Online" or "Succeeded" or "Active" or "Managed" or "Running" or "Approved" or "Started" => Color.Success,
        "Pending" or "Submitted" or "Scheduled" or "Drifted" or "NeedsReapproval" or "Starting" or "Stopping" => Color.Warning,
        "Offline" or "Failed" or "Denied" or "Missing" or "RollbackFailed" or "Stopped" => Color.Error,
        "Revoked" or "Rejected" or "Expired" or "Cancelled" => Color.Dark,
        "RolledBack" => Color.Secondary,
        "ReadOnly" or "Unassigned" => Color.Info,
        _ => Color.Default,
    };
}

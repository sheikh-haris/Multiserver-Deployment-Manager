@page "/deployments"
@attribute [Authorize]
@implements IDisposable
@inject ActorProvider Actors
@inject DeploymentService Deployments
@inject DeploymentEventBus Bus
@inject NavigationManager Nav
@using IisControlCenter.Core.Deployments
@using IisControlCenter.Web.Deployments
<PageTitle>Deployments</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Deployments</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.RocketLaunch" OnClick="@(() => Nav.NavigateTo("/deployments/new"))">New deployment</MudButton>
</MudStack>

@if (_queue is null) { <MudProgressLinear Indeterminate="true" /> }
else
{
    <MudTabs Elevation="1" Rounded="true" TabPanelsClass="pa-2" @bind-ActivePanelIndex="_tab">
        <MudTabPanel Text="@($"Waiting for my approval ({_queue.Count})")" BadgeData="@(_queue.Count > 0 ? _queue.Count : null)" BadgeColor="Color.Warning">
            <RequestTable Rows="_queue" ShowProgress="true" Empty="Nothing is waiting for you." />
        </MudTabPanel>
        <MudTabPanel Text="My requests"><RequestTable Rows="_mine" Empty="You have not submitted anything." /></MudTabPanel>
        <MudTabPanel Text="Open"><RequestTable Rows="_open" Empty="Nothing is in progress." /></MudTabPanel>
        <MudTabPanel Text="History"><RequestTable Rows="_all" Empty="No deployments yet." /></MudTabPanel>
    </MudTabs>
}

@code {
    private Actor? _actor;
    private IReadOnlyList<RequestRow>? _queue, _mine, _open, _all;
    private int _tab;

    protected override async Task OnInitializedAsync()
    {
        _actor = await Actors.GetAsync();
        await Load();
        Bus.Changed += OnChanged;
    }

    private async Task Load()
    {
        _queue = await Deployments.ApprovalQueueAsync(_actor!);
        _mine = await Deployments.ListAsync(_actor!, onlyMine: true);
        _open = await Deployments.ListAsync(_actor!, onlyOpen: true);
        _all = await Deployments.ListAsync(_actor!);
    }

    private void OnChanged(DeploymentChanged e)
    {
        if (e.LogOnly) return;
        _ = InvokeAsync(async () => { await Load(); StateHasChanged(); });
    }

    public void Dispose() => Bus.Changed -= OnChanged;
}

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.subtitle1" Class="mb-1">@Title</MudText>
        @if (!string.IsNullOrEmpty(Hint)) { <MudText Typo="Typo.caption" Class="d-block mb-2">@Hint</MudText> }
        <MudGrid>
            @switch (Op)
            {
                case IisOp.CreatePool:
                    <MudItem xs="12"><MudTextField T="string" @bind-Value="_poolName" Label="App pool name" Immediate="true" /></MudItem>
                    <MudItem xs="12"><MudText Typo="Typo.caption">The pool starts with IIS defaults (CLR v4.0, Integrated). Edit its settings afterwards on the app pools page.</MudText></MudItem>
                    break;
                case IisOp.CreateSite:
                    <MudItem xs="12" md="6"><MudTextField T="string" @bind-Value="_siteName" Label="Site name" Immediate="true" /></MudItem>
                    <MudItem xs="12" md="6"><MudSelect T="string" @bind-Value="_pool" Label="App pool">@foreach (var p in Pools) { <MudSelectItem T="string" Value="@p">@p</MudSelectItem> }</MudSelect></MudItem>
                    <MudItem xs="12"><MudTextField T="string" @bind-Value="_folder" Label="Folder on the server" Placeholder="@FolderHint" Immediate="true" /></MudItem>
                    <MudItem xs="12">@FolderCheck</MudItem>
                    <MudItem xs="12">@BindingsEditor</MudItem>
                    <MudItem xs="12"><MudText Typo="Typo.caption">The site is created <b>stopped</b>. Start it from the list when you are ready.</MudText></MudItem>
                    break;
                case IisOp.UpdateBindings:
                    <MudItem xs="12">@BindingsEditor</MudItem>
                    <MudItem xs="12"><MudText Typo="Typo.caption">Only HTTP bindings are shown and changed. HTTPS bindings and certificates stay in IIS Manager and are not touched.</MudText></MudItem>
                    break;
                case IisOp.CreateApplication:
                    <MudItem xs="12" md="6"><MudTextField T="string" @bind-Value="_appPath" Label="Application path" Placeholder="/api" Immediate="true" /></MudItem>
                    <MudItem xs="12" md="6"><MudSelect T="string" @bind-Value="_pool" Label="App pool">@foreach (var p in Pools) { <MudSelectItem T="string" Value="@p">@p</MudSelectItem> }</MudSelect></MudItem>
                    <MudItem xs="12"><MudTextField T="string" @bind-Value="_folder" Label="Folder on the server" Placeholder="@FolderHint" Immediate="true" /></MudItem>
                    <MudItem xs="12">@FolderCheck</MudItem>
                    break;
                case IisOp.CreateVirtualDirectory:
                    <MudItem xs="12" md="6"><MudSelect T="string" @bind-Value="_app" Label="Inside application">@foreach (var a in Apps) { <MudSelectItem T="string" Value="@a">@a</MudSelectItem> }</MudSelect></MudItem>
                    <MudItem xs="12" md="6"><MudTextField T="string" @bind-Value="_vpath" Label="Virtual directory path" Placeholder="/files" Immediate="true" /></MudItem>
                    <MudItem xs="12"><MudTextField T="string" @bind-Value="_folder" Label="Folder on the server" Placeholder="@FolderHint" Immediate="true" /></MudItem>
                    <MudItem xs="12">@FolderCheck</MudItem>
                    break;
                case IisOp.CreateFolder:
                    <MudItem xs="12"><MudTextField T="string" @bind-Value="_folder" Label="New folder" Placeholder="@FolderHint" Immediate="true" /></MudItem>
                    break;
                case IisOp.GrantFolderAccess:
                    <MudItem xs="12" md="6"><MudSelect T="string" @bind-Value="_pool" Label="App pool (the account IIS AppPool\name)">@foreach (var p in Pools) { <MudSelectItem T="string" Value="@p">@p</MudSelectItem> }</MudSelect></MudItem>
                    <MudItem xs="12" md="6"><MudSelect T="FolderAccess" @bind-Value="_access" Label="Access">
                        <MudSelectItem T="FolderAccess" Value="FolderAccess.Read">Read</MudSelectItem>
                        <MudSelectItem T="FolderAccess" Value="FolderAccess.ReadExecute">Read and execute (normal for a site)</MudSelectItem>
                        @if (CanModify) { <MudSelectItem T="FolderAccess" Value="FolderAccess.Modify">Modify (write: for upload and data folders)</MudSelectItem> }
                    </MudSelect></MudItem>
                    <MudItem xs="12"><MudTextField T="string" @bind-Value="_folder" Label="Existing folder" Placeholder="@FolderHint" Immediate="true" /></MudItem>
                    <MudItem xs="12"><MudText Typo="Typo.caption">Applies to the folder and what is inside it. Never FullControl, never any other account.</MudText></MudItem>
                    break;
            }
            @if (NeedReason)
            {
                <MudItem xs="12"><MudTextField T="string" @bind-Value="_reason" Label="@(NeedsApproval ? "Reason (a second person approves this)" : "Reason")" Lines="2" Immediate="true" /></MudItem>
            }
        </MudGrid>
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mt-2" Dense="true">@_error</MudAlert> }
        @if (NeedsApproval) { <MudAlert Severity="Severity.Warning" Class="mt-2" Dense="true">Production: this is sent to a second Server Operator or Platform Admin. It runs when they approve.</MudAlert> }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">@(NeedsApproval ? "Send for approval" : "Do it")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public IisOp Op { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public IReadOnlyList<string> Pools { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Apps { get; set; } = ["/"];
    [Parameter] public long SiteId { get; set; }
    [Parameter] public IReadOnlyList<HttpBinding> CurrentBindings { get; set; } = [];
    [Parameter] public bool CanModify { get; set; }
    [Parameter] public bool NeedsApproval { get; set; }
    [Parameter] public bool OwnerMode { get; set; }
    [Parameter] public string? FolderHint { get; set; }

    private string _poolName = "", _siteName = "", _pool = "", _folder = "", _appPath = "", _app = "/", _vpath = "", _reason = "";
    private bool _create = true;
    private FolderAccess _access = FolderAccess.ReadExecute;
    private string? _error;
    private List<(string Host, string Port)> _bindings = [("", "80")];

    private bool NeedReason => NeedsApproval || (Op == IisOp.GrantFolderAccess && _access == FolderAccess.Modify);

    protected override void OnInitialized()
    {
        if (Pools.Count > 0) _pool = Pools[0];
        if (Op == IisOp.UpdateBindings && CurrentBindings.Count > 0) _bindings = CurrentBindings.Select(b => (b.Host, b.Port.ToString())).ToList();
        if (Apps.Count > 0) _app = Apps[0];
    }

    private RenderFragment FolderCheck => OwnerMode
        ? @<MudText Typo="Typo.caption">The folder must not exist yet. It is created for you.</MudText>
        : @<MudCheckBox T="bool" @bind-Value="_create" Label="Create the folder if it does not exist" />;

    private RenderFragment BindingsEditor => @<div>
        <MudText Typo="Typo.subtitle2">HTTP bindings (any IP, host name and port)</MudText>
        @for (var i = 0; i < _bindings.Count; i++)
        {
            var idx = i;
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudTextField T="string" Value="_bindings[idx].Host" ValueChanged="@(v => _bindings[idx] = (v ?? "", _bindings[idx].Port))" Label="Host name" Placeholder="app.example.local" Immediate="true" Style="min-width:260px" />
                <MudTextField T="string" Value="_bindings[idx].Port" ValueChanged="@(v => _bindings[idx] = (_bindings[idx].Host, v ?? ""))" Label="Port" Immediate="true" Style="max-width:100px" />
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _bindings.RemoveAt(idx))" Disabled="@(_bindings.Count <= 1)" />
            </MudStack>
        }
        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _bindings.Add(("", "80")))">Add binding</MudButton>
    </div>;

    public sealed record Result(IisOpCommand Command, string? Reason);

    private void Save()
    {
        _error = null;
        var bindings = new List<HttpBinding>();
        foreach (var b in _bindings)
        {
            if (!int.TryParse(b.Port, out var port)) { _error = $"'{b.Port}' is not a port number."; return; }
            bindings.Add(new HttpBinding(b.Host.Trim(), port));
        }
        var c = new IisOpCommand
        {
            Op = Op, SiteId = SiteId, PoolName = Op == IisOp.CreatePool ? _poolName.Trim() : _pool, SiteName = _siteName.Trim(), PhysicalPath = _folder.Trim(), CreateFolder = _create || OwnerMode,
            Bindings = Op is IisOp.CreateSite or IisOp.UpdateBindings ? bindings : null, ExpectedBindings = Op == IisOp.UpdateBindings ? CurrentBindings : null,
            AppPath = Op == IisOp.CreateVirtualDirectory ? _app : _appPath.Trim(), VirtualPath = _vpath.Trim(), Access = Op == IisOp.GrantFolderAccess ? _access : null,
        };
        if (IisOpsService.Validate(c) is { } problem) { _error = problem; return; }
        if (NeedReason && string.IsNullOrWhiteSpace(_reason)) { _error = "Write the reason."; return; }
        Dialog.Close(DialogResult.Ok(new Result(c, string.IsNullOrWhiteSpace(_reason) ? null : _reason.Trim())));
    }
}

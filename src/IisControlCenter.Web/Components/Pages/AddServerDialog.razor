@inject ActorProvider Actors
@inject ServerService Servers
@inject IConfiguration Config
@inject IJSRuntime Js
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_result is null)
        {
            <MudTextField T="string" @bind-Value="_name" Label="Server name" HelperText="A display name, for example DEV-WEB01." Immediate="true" />
            @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert> }
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                This token is shown <b>once</b> and expires at <b>@_result.ExpiresAt.ToLocalTime().ToString("g")</b> (1 hour). It can be used one time.
            </MudAlert>
            <MudTextField T="string" Value="_result.Token" ReadOnly="true" Label="Registration token" Class="mono" />
            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Run on the IIS server, as Administrator:</MudText>
            <MudPaper Outlined="true" Class="pa-3 mono" Style="white-space:pre-wrap;word-break:break-all">@Command</MudPaper>
            <MudButton Class="mt-2" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="Copy">Copy command</MudButton>
            <MudText Typo="Typo.body2" Class="mt-3">
                Set <b>-Environment</b> and <b>-AllowedRoots</b> to the real values for that server. They are saved on the server and
                cannot be changed from this portal. The server stays <b>Pending</b> until you approve it.
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        @if (_result is null)
        {
            <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Create" Disabled="_busy">Create</MudButton>
        }
        else { <MudButton Color="Color.Primary" OnClick="() => Dialog.Close()">Done</MudButton> }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;
    private string _name = "";
    private string? _error;
    private bool _busy;
    private NewServerResult? _result;

    private string Command
    {
        get
        {
            var host = Config["Portal:AgentsHost"] ?? "agents.example.local";
            return $".\\Install-Agent.ps1 -PortalUrl https://{host} -Token {_result!.Token} -Environment <Dev|Staging|Prod> -AllowedRoots 'D:\\Websites' -AgentExePath .\\IisControlCenter.Agent.exe";
        }
    }

    private async Task Create()
    {
        _busy = true; _error = null;
        try
        {
            var r = await Servers.CreateAsync(await Actors.GetAsync(), _name);
            if (r.Ok) _result = r.Value; else _error = r.Error;
        }
        catch (ForbiddenException ex) { _error = ex.Message; }
        _busy = false;
    }

    private async Task Copy()
    {
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", Command);
        Snackbar.Add("Copied", Severity.Success);
    }
}

@page "/projects/{Id:guid}"
@attribute [Authorize]
@implements IDisposable
@inject ActorProvider Actors
@inject ProjectService Projects
@inject MembershipService Members
@inject TargetService Targets
@inject DeploymentService DeploymentsSvc
@inject PoolAdminService PoolAdmin
@inject ProtectedListService ProtectedLists
@inject ServerEventBus Bus
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>@(_view?.Project.Name ?? "Project")</PageTitle>

@if (_loaded && _view is null)
{
    <MudAlert Severity="Severity.Warning">Project not found, or you do not have access to it.</MudAlert>
}
else if (_view is not null)
{
    var p = _view.Project;
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/projects"))" />
        <MudText Typo="Typo.h4">@p.Name</MudText>
        <StatusChip Status="@(p.IsActive ? "Active" : "Inactive")" />
        <MudSpacer />
        @if (_view.CanManage || _view.CanRequestLink)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Link" OnClick="@(() => Nav.NavigateTo("/onboarding"))">Map an IIS item</MudButton>
        }
        @if (_view.CanManage)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditComponent(null)" Disabled="@(!p.IsActive)">Add component</MudButton>
        }
    </MudStack>
    @if (!string.IsNullOrWhiteSpace(p.Description)) { <MudText Class="mb-2">@p.Description</MudText> }
    @if (!string.IsNullOrEmpty(p.OwnerGroupName)) { <MudText Typo="Typo.caption" Class="d-block mb-3">Owner group: @p.OwnerGroupName</MudText> }

    <MudTabs Elevation="1" Rounded="true" TabPanelsClass="pa-4">
        <MudTabPanel Text="@($"Components ({_view.Components.Count})")">
            @if (_view.Components.Count == 0)
            {
                <MudText>No components yet. A component is one separately deployable application, for example "Web Frontend".</MudText>
            }
            @foreach (var c in _view.Components)
            {
                <MudPaper Outlined="true" Class="pa-3 mb-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.h6">@c.Name</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@c.Type</MudChip>
                        <MudText Typo="Typo.caption">health: <span class="mono">@c.HealthCheckPath</span></MudText>
                        @if (c.RequiresStagingBeforeProd) { <MudChip T="string" Size="Size.Small" Color="Color.Info">Staging required before Prod</MudChip> }
                        <MudSpacer />
                        @foreach (var env in c.Targets.Select(t => t.EnvironmentName).Distinct().Where(e => _actor!.Access.CanOnProject(ProjectPermission.SubmitDeployment, Id, e)))
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="@(env == "Prod" ? Color.Error : Color.Primary)" StartIcon="@Icons.Material.Filled.RocketLaunch"
                                       OnClick="@(() => Nav.NavigateTo($"/deployments/new?component={c.Id}&env={env}"))">Deploy to @env</MudButton>
                        }
                        @if (_view.CanManage)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditComponent(c)" title="Edit" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveComponent(c)" title="Remove" />
                        }
                    </MudStack>

                    @if (_actor!.Access.IsProjectOwner(Id))
                    {
                        <MudStack Row="true" Class="mt-2" Spacing="1" Wrap="Wrap.Wrap">
                            @foreach (var sv in c.Targets.Where(x => x.EnvironmentName != "Prod").Select(x => (x.ServerId, x.ServerName, x.EnvironmentName)).Distinct())
                            {
                                var link = sv;
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Dns" OnClick="@(() => Nav.NavigateTo($"/servers/{link.ServerId}/iis?project={Id}"))">IIS on @link.ServerName (@link.EnvironmentName)</MudButton>
                            }
                        </MudStack>
                    }
                    @if (c.Targets.Count == 0) { <MudText Class="mt-2" Typo="Typo.body2">No deployment targets yet.</MudText> }
                    else
                    {
                        <MudSimpleTable Dense="true" Hover="true" Class="mt-2">
                            <thead><tr><th>Env</th><th>Order</th><th>Server</th><th>Site / application</th><th>Folder</th><th>App pool</th><th>Status</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var t in c.Targets)
                            {
                                <tr>
                                    <td>@t.EnvironmentName</td>
                                    <td>
                                        @t.DeployOrder
                                        @if (_view.CanManage && c.Targets.Count(x => x.EnvironmentName == t.EnvironmentName) > 1)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" OnClick="() => Move(t, true)" />
                                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" OnClick="() => Move(t, false)" />
                                        }
                                    </td>
                                    <td>@t.ServerName</td>
                                    <td>@t.IisSiteName@(t.AppPath == "/" ? "" : t.AppPath)</td>
                                    <td class="mono">@t.PhysicalPath</td>
                                    <td>@t.AppPoolName @if (t.HasException) { <MudTooltip Text="Shared pool allowed by a recorded admin exception"><MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" /></MudTooltip> }</td>
                                    <td>
                                        <MudTooltip Text="@(t.StatusDetail ?? "")" Disabled="@string.IsNullOrEmpty(t.StatusDetail)"><StatusChip Status="@t.Status.ToString()" /></MudTooltip>
                                        @if (!string.IsNullOrEmpty(t.StatusDetail)) { <MudText Typo="Typo.caption" Class="d-block" Style="max-width:260px">@t.StatusDetail</MudText> }
                                    </td>
                                    <td>
                                        @if (t.Status == TargetStatus.Active && _actor!.Access.CanOnProject(ProjectPermission.RecyclePool, Id, t.EnvironmentName))
                                        {
                                            <MudTooltip Text="Recycle the app pool of this application (briefly restarts it)"><MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Autorenew" OnClick="() => Recycle(t)">Recycle pool</MudButton></MudTooltip>
                                        }
                                        @if (_view.CanManage)
                                        {
                                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small">
                                                @if (t.Status is TargetStatus.Drifted or TargetStatus.Missing) { <MudMenuItem OnClick="() => Accept(t)">Accept what IIS has now</MudMenuItem> }
                                                <MudMenuItem OnClick="() => Disable(t)">@(t.Status == TargetStatus.Disabled ? "Enable" : "Disable")</MudMenuItem>
                                                <MudMenuItem OnClick="() => RemoveTarget(t)">Remove link</MudMenuItem>
                                            </MudMenu>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </MudSimpleTable>
                    }
                    <MudExpansionPanels Class="mt-2" Elevation="0">
                        <MudExpansionPanel Text="Protected paths">
                            <MudText Typo="Typo.caption" Class="d-block mb-1">Config files are copied only if they do not exist on the target. Data folders are never overwritten, never deleted and never backed up. A pattern without a slash matches in the site root only; use <span class="mono">**\</span> for any depth.</MudText>
                            @foreach (var pp in c.ProtectedPaths)
                            {
                                var ppc = pp;
                                @if (_view.CanManage && !pp.IsDefault)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="@(pp.Kind == ProtectedPathKind.DataFolder ? Color.Error : Color.Default)" Variant="Variant.Outlined"
                                             OnClose="@(() => RemovePath(c, ppc))">@(pp.Kind == ProtectedPathKind.DataFolder ? "data" : "config"): @pp.Path</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="@(pp.Kind == ProtectedPathKind.DataFolder ? Color.Error : Color.Default)" Variant="Variant.Outlined">@(pp.Kind == ProtectedPathKind.DataFolder ? "data" : "config"): @pp.Path</MudChip>
                                }
                            }
                            @if (_view.CanManage)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2" Wrap="Wrap.Wrap">
                                    <MudTextField T="string" @bind-Value="_newPath" Label="Add path" Immediate="true" Style="max-width:300px" />
                                    <MudSelect T="ProtectedPathKind" @bind-Value="_newKind" Label="Kind" Style="max-width:160px">
                                        <MudSelectItem T="ProtectedPathKind" Value="ProtectedPathKind.DataFolder">Data folder</MudSelectItem>
                                        <MudSelectItem T="ProtectedPathKind" Value="ProtectedPathKind.ConfigFile">Config file</MudSelectItem>
                                    </MudSelect>
                                    <MudButton Variant="Variant.Outlined" OnClick="() => AddPath(c)">Add</MudButton>
                                </MudStack>
                                <MudDivider Class="my-2" />
                                @if (_confirmed.TryGetValue(c.Id, out var conf) && conf is not null)
                                {
                                    <MudAlert Severity="Severity.Success" Dense="true">Data folders confirmed complete by @conf.ConfirmedBy on @conf.ConfirmedAt.ToLocalTime().ToString("yyyy-MM-dd"). Full Replace is allowed.</MudAlert>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true">Full Replace is blocked until you confirm that the data folders above are complete (user uploads, generated files, anything the application writes). Any change to the list voids the confirmation.</MudAlert>
                                }
                                <MudButton Class="mt-1" Variant="Variant.Outlined" OnClick="() => ConfirmList(c)">The data folders are complete: confirm</MudButton>
                            }
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudPaper>
            }
        </MudTabPanel>

        <MudTabPanel Text="@($"Members ({_members.Count})")">
            <MudStack Row="true" Class="mb-3" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2">Roles are given per environment. Prefer groups. Individual users need an expiry date.</MudText>
                <MudSpacer />
                @if (_view.CanManageMembers) { <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="Grant">Add member</MudButton> }
            </MudStack>

            <MudSimpleTable Dense="true" Class="mb-4">
                <thead><tr><th>Role</th>@foreach (var e in _view.VisibleEnvironments) { <th>@e</th> }</tr></thead>
                <tbody>
                @foreach (var role in new[] { Role.ProjectViewer, Role.Deployer, Role.Approver })
                {
                    <tr>
                        <td><b>@role</b></td>
                        @foreach (var e in _view.VisibleEnvironments)
                        {
                            <td>@foreach (var m in _members.Where(m => m.Role == role && m.EnvironmentName == e && !m.Expired)) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@m.PrincipalName</MudChip> }</td>
                        }
                    </tr>
                }
                <tr><td><b>ProjectOwner</b></td><td colspan="@Math.Max(1, _view.VisibleEnvironments.Count)">@foreach (var m in _members.Where(m => m.Role == Role.ProjectOwner)) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@m.PrincipalName</MudChip> }</td></tr>
                </tbody>
            </MudSimpleTable>

            <MudSimpleTable Dense="true" Hover="true">
                <thead><tr><th>Who</th><th>Type</th><th>Role</th><th>Environment</th><th>Expires</th><th>Granted by</th><th></th></tr></thead>
                <tbody>
                @foreach (var m in _members)
                {
                    <tr>
                        <td>@m.PrincipalName <span class="mono">(@m.PrincipalId)</span></td><td>@m.PrincipalType</td><td>@m.Role</td><td>@(m.EnvironmentName ?? "All")</td>
                        <td>@if (m.ExpiresAt is null) { <span>never</span> } else { <span>@m.ExpiresAt.Value.ToLocalTime().ToString("d")</span> @if (m.Expired) { <StatusChip Status="Expired" /> } }</td>
                        <td>@m.GrantedBy</td>
                        <td>@if (m.CanRevoke && _view.CanManageMembers) { <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => RevokeMember(m)">Revoke</MudButton> }</td>
                    </tr>
                }
                </tbody>
            </MudSimpleTable>
        </MudTabPanel>

        <MudTabPanel Text="History">
            <RequestTable Rows="_history" Empty="No deployments for this project yet." />
        </MudTabPanel>

        @if (_view.CanManage)
        {
            <MudTabPanel Text="Settings">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Direct to Production approvers</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">How many different approvers a direct-to-Production deployment needs (Phase 3).</MudText>
                <MudToggleGroup T="int" Value="p.ProdApproversRequired" ValueChanged="SetProdApprovers" Color="Color.Primary" Class="mb-4">
                    <MudToggleItem Value="1" Text="1 approver" /><MudToggleItem Value="2" Text="2 approvers" />
                </MudToggleGroup>

                <MudText Typo="Typo.subtitle1" Class="mb-1">Self-approval</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">Off by default. When on, a person who holds both Deployer and Approver may approve their own request in that environment. Every approval is audited; self-approved ones are badged and reported.</MudText>
                @foreach (var kv in _view.SelfApproval)
                {
                    var env = kv.Key;
                    <MudSwitch T="bool" Value="kv.Value" ValueChanged="@((bool v) => SetSelf(env, v))" Color="@(env == "Prod" ? Color.Error : Color.Primary)" Label="@($"Allow self-approval on {env}")" />
                }

                <MudText Typo="Typo.subtitle1" Class="mt-4 mb-1">Email notifications</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">This address (or several, separated by ;) gets an email when a request needs approval and when a deployment finishes. Emails contain names and links only.</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudTextField T="string" @bind-Value="_notifyEmail" Label="Notification email" Immediate="true" Style="max-width:420px" />
                    <MudButton Variant="Variant.Outlined" OnClick="SaveNotify">Save</MudButton>
                </MudStack>

                <MudDivider Class="my-4" />
                <MudStack Row="true">
                    <MudButton Variant="Variant.Outlined" OnClick="Rename">Rename / edit description</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="@(p.IsActive ? Color.Error : Color.Success)" OnClick="ToggleActive">@(p.IsActive ? "Deactivate project" : "Reactivate project")</MudButton>
                </MudStack>
            </MudTabPanel>
        }
    </MudTabs>
}
else { <MudProgressLinear Indeterminate="true" /> }

@code {
    [Parameter] public Guid Id { get; set; }
    private ProjectView? _view;
    private IReadOnlyList<MemberRow> _members = [];
    private Actor? _actor;
    private bool _loaded;
    private IReadOnlyList<RequestRow> _history = [];
    private readonly Dictionary<Guid, ProtectedListConfirmation?> _confirmed = new();
    private string? _newPath, _notifyEmail;
    private ProtectedPathKind _newKind = ProtectedPathKind.DataFolder;

    protected override void OnInitialized() => Bus.Changed += OnChanged;
    protected override async Task OnParametersSetAsync() => await Reload();

    private async Task Reload()
    {
        _actor = await Actors.GetAsync();
        _view = await Projects.GetAsync(_actor, Id);
        try { _members = _view is null ? [] : await Members.ListAsync(_actor, Id); } catch (ForbiddenException) { _members = []; }
        if (_view is not null)
        {
            _history = await DeploymentsSvc.ListAsync(_actor, projectId: Id, take: 100);
            _notifyEmail = _view.Project.NotificationEmail;
            _confirmed.Clear();
            foreach (var c in _view.Components) _confirmed[c.Id] = await ProtectedLists.GetConfirmationAsync(c.Id);
        }
        _loaded = true;
    }

    private Task AddPath(ComponentView c) { var path = _newPath ?? ""; _newPath = null; return Run(() => ProtectedLists.AddAsync(_actor!, c.Id, path, _newKind), "Added."); }
    private Task RemovePath(ComponentView c, ProtectedPath p) => Run(() => ProtectedLists.RemoveAsync(_actor!, c.Id, p.Id), "Removed.");
    private Task ConfirmList(ComponentView c) => Run(() => ProtectedLists.ConfirmAsync(_actor!, c.Id), "Confirmed.");
    private Task SaveNotify() => Run(() => Projects.SetNotificationEmailAsync(_actor!, Id, _notifyEmail), "Saved.");

    private void OnChanged(ServerChanged e) => _ = InvokeAsync(async () => { await Reload(); StateHasChanged(); });

    private async Task Run(Func<Task<OpResult>> action, string ok)
    {
        try { var r = await action(); Snackbar.Add(r.Ok ? ok : r.Error ?? "Failed", r.Ok ? Severity.Success : Severity.Error); }
        catch (ForbiddenException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        await Reload();
    }

    private async Task EditComponent(ComponentView? c)
    {
        var dlg = await Dialogs.ShowAsync<ComponentDialog>(c is null ? "Add component" : "Edit component",
            new DialogParameters<ComponentDialog> { { x => x.ProjectId, Id }, { x => x.Existing, c } }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if ((await dlg.Result) is { Canceled: false }) await Reload();
    }

    private async Task RemoveComponent(ComponentView c)
    {
        if (!await Confirm("Remove component", $"Remove the component and its protected path list? It must have no targets.", c.Name, "Remove")) return;
        await Run(() => Projects.RemoveComponentAsync(_actor!, c.Id), "Component removed.");
    }

    private async Task Recycle(TargetView t)
    {
        var confirmed = t.EnvironmentName != "Prod";
        var verb = $"Recycle app pool '{t.AppPoolName}' on {t.ServerName}? The application restarts; requests in progress may fail briefly.";
        if (t.EnvironmentName == "Prod")
        {
            var dlg = await Dialogs.ShowAsync<ConfirmDangerDialog>("PRODUCTION: recycle pool", new DialogParameters<ConfirmDangerDialog> { { x => x.Message, verb }, { x => x.ConfirmText, "PROD" }, { x => x.ButtonText, "Recycle" } });
            confirmed = (await dlg.Result) is { Canceled: false };
        }
        else confirmed = await Dialogs.ShowMessageBoxAsync("Recycle pool?", verb, yesText: "Recycle", cancelText: "Cancel") == true;
        if (!confirmed) return;
        try
        {
            var r = await PoolAdmin.RecycleForTargetAsync(_actor!, t.Id, true);
            Snackbar.Add(r.Ok ? $"Recycled {t.AppPoolName}. {r.Message}" : r.Message, r.Ok ? Severity.Success : Severity.Error);
        }
        catch (ForbiddenException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private Task Move(TargetView t, bool up) => Run(() => Targets.MoveAsync(_actor!, t.Id, up), "Order changed.");
    private Task Accept(TargetView t) => Run(() => Targets.AcceptCurrentAsync(_actor!, t.Id), "Accepted. The target is active again.");
    private Task Disable(TargetView t) => Run(() => Targets.SetDisabledAsync(_actor!, t.Id, t.Status != TargetStatus.Disabled), t.Status == TargetStatus.Disabled ? "Enabled." : "Disabled.");

    private async Task RemoveTarget(TargetView t)
    {
        if (!await Confirm("Remove link", $"This only removes the link in the portal. The IIS site is not touched.", t.IisSiteName, "Remove link")) return;
        await Run(() => Targets.RemoveAsync(_actor!, t.Id), "Link removed.");
    }

    private async Task Grant()
    {
        var dlg = await Dialogs.ShowAsync<GrantRoleDialog>("Add member", new DialogParameters<GrantRoleDialog> { { x => x.ProjectId, Id }, { x => x.IsPlatformAdmin, _actor!.Can(Permission.ManageProjects) } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await dlg.Result) is { Canceled: false }) { Snackbar.Add("Role granted.", Severity.Success); await Reload(); }
    }

    private async Task RevokeMember(MemberRow m)
    {
        if (!await Confirm("Revoke role", $"Remove {m.Role} from {m.PrincipalName}?", m.PrincipalName, "Revoke")) return;
        await Run(() => Members.RevokeAsync(_actor!, m.Id), "Role revoked.");
    }

    private Task SetProdApprovers(int n) => Run(() => Projects.SetProdApproversAsync(_actor!, Id, n), "Saved.");
    private Task SetSelf(string env, bool on) => Run(() => Projects.SetSelfApprovalAsync(_actor!, Id, env, on), on ? $"Self-approval is ON for {env}. This is audited." : "Saved.");
    private Task ToggleActive() => Run(() => Projects.SetActiveAsync(_actor!, Id, !_view!.Project.IsActive), "Saved.");

    private async Task Rename()
    {
        var dlg = await Dialogs.ShowAsync<RenameProjectDialog>("Edit project", new DialogParameters<RenameProjectDialog> { { x => x.ProjectId, Id }, { x => x.CurrentName, _view!.Project.Name }, { x => x.CurrentDescription, _view.Project.Description } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if ((await dlg.Result) is { Canceled: false }) await Reload();
    }

    private async Task<bool> Confirm(string title, string message, string confirmText, string button)
    {
        var dlg = await Dialogs.ShowAsync<ConfirmDangerDialog>(title, new DialogParameters<ConfirmDangerDialog>
        { { x => x.Message, message }, { x => x.ConfirmText, confirmText }, { x => x.ButtonText, button } }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        return (await dlg.Result) is { Canceled: false };
    }

    public void Dispose() => Bus.Changed -= OnChanged;
}
